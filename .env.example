# ── Notion（データストア / MVP必須） ─────────────────────────
# https://www.notion.so/my-integrations で Integration を作成し取得
NOTION_TOKEN=
# 保存先データベースのID（DB URL の英数字32桁部分）
NOTION_DATABASE_ID=
# 監視企業を動的管理する設定DBのID（任意）。未設定なら静的な既定3銘柄を使用。
NOTION_TICKERS_DATABASE_ID=
# AIピックアップ（各企業の注目まとめ）保存DBのID（任意）。未設定ならピックアップ非表示。
NOTION_PICKS_DATABASE_ID=

# ── 管理操作の認証（企業追加など / 任意） ───────────────────
# 設定すると PWA の /admin から企業追加が可能に。未設定なら管理操作は無効。
ADMIN_PASSWORD=

# ── API消費量ゲージ（任意） ─────────────────────────────────
# 使用量を1日1行で記録するNotion DBのID。未設定ならゲージは非表示。
NOTION_USAGE_DATABASE_ID=
# 無料枠の上限（ゲージ・ロック判定の分母）。プラン変更時に調整。
GROQ_DAILY_REQUESTS=1000
GROQ_DAILY_TOKENS=100000
NOTION_DAILY_WRITES_SOFT=1000
VERCEL_DAILY_RUNS_SOFT=100

# ── Cron 認可（MVP必須） ─────────────────────────────────────
# /api/cron/collect を保護するシークレット。
# Vercel では Cron 実行時に Authorization: Bearer <CRON_SECRET> が付与される。
CRON_SECRET=

# ── 収集チューニング（任意） ────────────────────────────────
# 1回の収集で保存する新着の最大件数。Vercel無料プランの関数60秒制限内に
# 収めるためのガード。超過分は冪等性により次回以降に繰り越し保存。既定: 60
MAX_SAVES_PER_RUN=

# ── SEC EDGAR（任意） ────────────────────────────────────────
# SEC は User-Agent に連絡先メールを必須とする。未設定でも既定値で動くが、
# 自分の連絡先に変更推奨。形式: "app-name/version (contact: you@example.com)"
SEC_USER_AGENT=

# ── AI要約（後続フェーズ / 非Gemini無料LLM） ─────────────────
# passthrough(既定) | llm
SUMMARIZER=passthrough
# https://console.groq.com/keys で無料取得（非Gemini）
GROQ_API_KEY=
# 任意。Groqはモデルを随時入替えるため上書き可能。既定: llama-3.3-70b-versatile
GROQ_MODEL=
# チャット(v2.0)用モデル（任意）。既定は軽量・高速な llama-3.1-8b-instant
GROQ_CHAT_MODEL=

# ── Web Push（M4 / iOS16+） ─────────────────────────────────
# 鍵生成: `npm run gen:vapid`（または npx web-push generate-vapid-keys）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# プッシュ購読の保存先（ニュースとは別のNotion DB）。未設定ならプッシュは無効。
NOTION_PUSH_DATABASE_ID=
